{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true
  },
  "recognition_enabled": {
    "description": "启用识别",
    "type": "bool",
    "default": true
  },
  "hf_repo_id": {
    "description": "Hugging Face 模型仓库",
    "type": "string",
    "default": "laiyoi/femboydetector"
  },
  "hf_model_filename": {
    "description": "ONNX 文件名",
    "type": "string",
    "default": "taste_classifier.onnx"
  },
  "hf_config_filename": {
    "description": "模型配置文件名",
    "type": "string",
    "default": "model_config.json"
  },
  "hf_revision": {
    "description": "HF revision/分支",
    "type": "string",
    "default": "main"
  },
  "auto_update_model": {
    "description": "自动检查并拉取模型更新",
    "type": "bool",
    "default": true
  },
  "model_update_interval_sec": {
    "description": "自动检查模型更新间隔（秒）",
    "type": "int",
    "default": 21600,
    "min": 300
  },
  "suspicious_save_at": {
    "description": "suspicious：发布者已保存至少多少张时保存",
    "type": "int",
    "default": 5,
    "min": 1
  },
  "suspicious_cache_below": {
    "description": "suspicious：发布者已保存少于多少张时缓存",
    "type": "int",
    "default": 3,
    "min": 0
  },
  "save_pending": {
    "description": "缓存 suspicious 图片",
    "type": "bool",
    "default": true
  },
  "dedupe": {
    "description": "按 SHA-256 去重",
    "type": "bool",
    "default": true
  },
  "strip_metadata": {
    "description": "保存前去除 EXIF/GPS",
    "type": "bool",
    "default": true
  },
  "max_file_mb": {
    "description": "图片大小上限 MB",
    "type": "int",
    "default": 12
  },
  "max_video_mb": {
    "description": "视频大小上限 MB",
    "type": "int",
    "default": 50
  },
  "video_max_frames": {
    "description": "视频最多抽帧数",
    "type": "int",
    "default": 8
  },
  "video_max_seconds": {
    "description": "视频抽帧最长秒数",
    "type": "int",
    "default": 15
  },
  "queue_size": {
    "description": "队列容量",
    "type": "int",
    "default": 256
  },
  "rate_limit_count": {
    "description": "时间窗内最多处理媒体数",
    "type": "int",
    "default": 60
  },
  "rate_limit_window_sec": {
    "description": "限流时间窗秒数",
    "type": "int",
    "default": 60
  },
  "cpu_threads": {
    "description": "ONNX CPU 线程数",
    "type": "int",
    "default": 4
  },
  "image_download_timeout_sec": {
    "description": "图片下载超时秒数",
    "type": "int",
    "default": 60
  }
}
